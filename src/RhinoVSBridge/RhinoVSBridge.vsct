      </Button>
      <Button guid="guidRhinoVSBridgeCmdSet" id="ShowDiagnostics" priority="0x0400" type="Button">
        <Parent guid="guidRhinoVSBridgeCmdSet" id="RhinoGroup" />
        <Strings>
          <ButtonText>Rhino: Diagnose Connection and Stubs</ButtonText>
          <CommandName>RhinoVSBridge.DiagnoseConnectionAndStubs</CommandName>
        </Strings>
      </Button>
      <Button guid="guidRhinoVSBridgeCmdSet" id="ChooseExecutable" priority="0x0500" type="Button">
        <Parent guid="guidRhinoVSBridgeCmdSet" id="RhinoGroup" />
        <Strings>
          <ButtonText>Rhino: Choose rhinocode.exe</ButtonText>
          <CommandName>RhinoVSBridge.ChooseRhinoCodeExecutable</CommandName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>
  <KeyBindings>
    <KeyBinding guid="guidRhinoVSBridgeCmdSet" id="RunActive" editor="GUID_TextEditorFactory" key1="VK_F2" mod1="Shift" />
