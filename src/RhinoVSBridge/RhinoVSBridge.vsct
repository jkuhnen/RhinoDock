  <Commands package="guidRhinoVSBridgePackage">
    <Groups>
      <Group guid="guidRhinoVSBridgeCmdSet" id="RhinoGroup" priority="0x0800">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
    </Groups>
    <Buttons>
      <Button guid="guidRhinoVSBridgeCmdSet" id="RunActive" priority="0x0100" type="Button">
        <Parent guid="guidRhinoVSBridgeCmdSet" id="RhinoGroup" />
        <Strings>
          <ButtonText>Rhino: Run Active Python Script</ButtonText>
          <CommandName>RhinoVSBridge.RunActivePythonScript</CommandName>
        </Strings>
      </Button>
      <Button guid="guidRhinoVSBridgeCmdSet" id="CancelActive" priority="0x0150" type="Button">
        <Parent guid="guidRhinoVSBridgeCmdSet" id="RhinoGroup" />
        <Strings>
          <ButtonText>Rhino: Cancel Running Script</ButtonText>
          <CommandName>RhinoVSBridge.CancelRunningScript</CommandName>
        </Strings>
      </Button>
      <Button guid="guidRhinoVSBridgeCmdSet" id="SelectInstance" priority="0x0200" type="Button">
        <Parent guid="guidRhinoVSBridgeCmdSet" id="RhinoGroup" />
        <Strings>
          <ButtonText>Rhino: Select Instance</ButtonText>
          <CommandName>RhinoVSBridge.SelectInstance</CommandName>
        </Strings>
      </Button>
      <Button guid="guidRhinoVSBridgeCmdSet" id="SetupIntelliSense" priority="0x0300" type="Button">
        <Parent guid="guidRhinoVSBridgeCmdSet" id="RhinoGroup" />
        <Strings>
          <ButtonText>Rhino: Configure Project IntelliSense</ButtonText>
          <CommandName>RhinoVSBridge.ConfigureProjectIntelliSense</CommandName>
