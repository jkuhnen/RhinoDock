<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Rhino Dock Python Project</Name>
    <Description>Python 3 scripting for Rhino 8 from Visual Studio using Rhino Dock.</Description>
    <ProjectType>Python</ProjectType>
    <LanguageTag>python</LanguageTag>
    <PlatformTag>windows</PlatformTag>
    <ProjectTypeTag>desktop</ProjectTypeTag>
    <SortOrder>100</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>RhinoDockProject</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
  </TemplateData>
  <TemplateContent>
    <Project File="RhinoDockPython.pyproj" TargetFileName="$safeprojectname$.pyproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="false" TargetFileName="main.py">main.py</ProjectItem>
    </Project>
  </TemplateContent>
</VSTemplate>
