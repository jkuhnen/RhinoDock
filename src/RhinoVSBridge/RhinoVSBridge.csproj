<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>RhinoVSBridge</AssemblyName>
    <RootNamespace>RhinoVSBridge</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <VsixDeployOnDebug>true</VsixDeployOnDebug>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Design" />
    <ProjectCapability Include="CreateVsixContainer" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.38461" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <VSCTCompile Include="RhinoVSBridge.vsct" />
    <None Update="source.extension.vsixmanifest" />
    <Content Include="Resources/RhinoDockIcon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="$(IntermediateOutputPath)RhinoDockPythonProject.zip">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ProjectTemplates/Python</VSIXSubPath>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
  <Target Name="PackageRhinoDockPythonProject" BeforeTargets="AssignTargetPaths">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)/Templates/RhinoDockPython"
                  DestinationFile="$(IntermediateOutputPath)RhinoDockPythonProject.zip"
                  Overwrite="true" />
  </Target>
</Project>
